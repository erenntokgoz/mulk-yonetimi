# Server only. Copy to .env.local for development.
BACKEND_BASE_URL=http://localhost:5080
FRONTEND_ORIGIN=http://localhost:3000

# Google girişi. İstemci kimliği ve sırrı yalnız sunucudadır; NEXT_PUBLIC_ önekiyle tanımlamayın.
# Yönlendirme adresi: http://localhost:3000/api/bff/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 1 olduğunda /giris ve /kayit üzerindeki "Google ile devam et" düğmesi görünür (derleme zamanı).
NEXT_PUBLIC_GOOGLE_AUTH=
