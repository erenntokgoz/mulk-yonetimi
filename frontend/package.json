{
  "name": "mulk-yonetimi-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --conditions=react-server --test tests/*.test.ts && pnpm test:components",
    "test:components": "vitest run --config vitest.config.ts",
    "test:browser": "playwright test",
    "test:browser:sql": "playwright test --config=playwright.sql.config.ts",
    "build": "next build",
    "api:types": "openapi-typescript http://127.0.0.1:5080/openapi/v1.json --output lib/api/generated.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.4",
    "@radix-ui/react-slot": "1.1.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "gsap": "3.12.5",
    "lenis": "1.1.13",
    "lucide-react": "0.400.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tailwind-merge": "2.6.0",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.170.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "10.6.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "jsdom": "^31.0.1",
    "openapi-typescript": "7.13.0",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "tailwindcss-animate": "1.0.7",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
