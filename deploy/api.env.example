# Copy to deploy/api.env on the server (chmod 600). Never commit api.env.

# Azure SQL: Portal > SQL database > Connection strings > ADO.NET. Use the dedicated app login, not the admin.
ConnectionStrings__DefaultConnection=Server=tcp:<server>.database.windows.net,1433;Initial Catalog=MulkYonetimi;User ID=<app-user>;Password=<password>;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;

# Public frontend origin (Vercel). Used for e-mail links and request origin checks.
Auth__FrontendOrigin=https://<frontend-domain>
AllowedHosts=<api-domain>

# Google sign-in: the OAuth client ID from Google Cloud Console (same value as Vercel GOOGLE_CLIENT_ID).
# ID tokens are accepted only when their audience equals this value. The API never needs the client secret.
# Leave empty to keep Google sign-in disabled (POST /api/v1/auth/google returns 503).
Auth__Google__ClientId=

# Pilot: unset DefaultUnitLimit means unlimited; set a positive unit count to enforce a quota for new accounts.
# AdminUserId must be an existing active, verified operator's user UUID. Keep AdminKey server-only (32+ random characters).
Pilot__DefaultUnitLimit=
Pilot__AdminUserId=
Pilot__AdminKey=

# Network__KnownProxies__0 is set to 127.0.0.1 in compose.api.yaml (host networking).
# Required in production. Also set the exact same random value in Vercel as
# BACKEND_RATE_LIMIT_SIGNING_KEY; never reuse Pilot__AdminKey.
Network__RateLimitSigningKey=

# E-mail (Mailu). Leave SmtpHost empty until Mailu is connected; registration returns 503 meanwhile.
Email__SmtpHost=mail.kasam360.com.tr
Email__SmtpPort=465
Email__SmtpUser=mulkum@360labs.com.tr
Email__SmtpPassword=
Email__From=mulkum@360labs.com.tr

# Documents stay disabled (fail-closed) until R2 and a malware scanner are configured.
# Per-account quotas include active and pending uploads; soft-deleted documents release quota.
# Defaults: 1000 documents and 1 GiB total. Set positive values only.
Storage__MaximumDocumentCountPerAccount=1000
Storage__MaximumStorageBytesPerAccount=1073741824
Storage__R2AccountId=
Storage__R2BucketName=
Storage__R2AccessKeyId=
Storage__R2SecretAccessKey=

# Only set after the scanner profile is healthy. Without this, document completion stays fail-closed.
Scanner__Host=
Scanner__Port=3310
